  "pipeline_phases": [
    {
      "id": "OS1",
      "titre": "Collecte et Préparation des Données",
      "description": "Acquisition de 10 images Sentinel-2/Landsat (2000-2024) pour les deux sites. QC visuel, génération de 5 000 patches augmentés (256×256 PNG). Annotation semi-automatique par seuil NDVI.",
      "outils": ["rasterio", "geopandas", "numpy", "Jupyter"],
      "statut": "✅ Complété",
      "outputs": ["5 000 PNG augmentés", "labels.csv (10 sources)", "manifest.csv"]
    },
    {
      "id": "OS2",
      "titre": "Extraction des Caractéristiques Spectrales",
      "description": "Calcul des 4 indices spectraux (NDVI, EVI2, NDWI, SAVI) sur toutes les images. Stacking en tenseurs 256×256×7 canaux float16. Analyse temporelle 2000-2024.",
      "outils": ["numpy", "rasterio", "scikit-learn"],
      "statut": "✅ Complété",
      "outputs": ["2 000 patches .npy 7ch (1.7 GB)", "manifest_7ch.csv", "temporal_indices_stats.csv", "temporal_indices.png"]
    },
    {
      "id": "OS3",
      "titre": "Entraînement du Modèle CNN",
      "description": "Architecture ForestCNN_256 : 4 blocs Conv2D + GlobalAveragePooling + Dense(256/64/1-sigmoid). 18 epochs sur GPU T4 Colab (17 min). Class weights {0:0.625, 1:1.375}. Seuil optimal : 0.1.",
      "outils": ["TensorFlow/Keras", "Google Colab GPU T4", "scikit-learn"],
      "statut": "✅ Entraîné (Accuracy=99.75%, AUC=1.00)",
      "outputs": ["best_forest_cnn_colab.keras (14.5 MB)", "training_history_colab.csv", "test_metrics_colab.csv", "training_curves_colab.png", "confusion_matrix_colab.png", "roc_curve_colab.png"]
    },
    {
      "id": "OS4",
      "titre": "Inférence par Fenêtre Glissante",
      "description": "Sliding window (patch=256, stride=128, overlap=50%) sur 10 images brutes. Reconstruction par moyenne. Détection pixel-par-pixel des changements. Anomalie détectée sur les années Sentinel-2 (2015, 2024) due à un décalage radiométrique inter-capteur.",
      "outils": ["TensorFlow/Keras", "rasterio", "numpy", "geopandas"],
      "statut": "✅ Exécuté (anomalie capteur Landsat/Sentinel-2 à corriger)",
      "outputs": ["20 GeoTIFF (mask + prob)", "6 shapefiles + 1 geojson multi-sites", "deforestation_stats.csv", "forest_area_timeline.png", "change_maps_abdoulaye.png", "change_maps_fazao.png"]
    },
    {
      "id": "OS5",
      "titre": "Cartographie et Livrables Opérationnels",
      "description": "Export GeoTIFF des masques, vectorisation en shapefiles, carte Folium interactive, rapport PDF/Excel, application Streamlit ForestGuard Togo.",
      "outils": ["rasterio", "geopandas", "folium", "ReportLab", "Streamlit"],
      "statut": "🔄 En cours (app Streamlit + correction anomalie capteur)",
      "outputs": ["carte_deforestation_interactive.html", "rapport_deforestation.pdf", "rapport_deforestation.xlsx", "forestguard_app.py"]
    }
  ],
